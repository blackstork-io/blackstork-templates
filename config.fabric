fabric {
  plugin_versions = {
    "blackstork/elastic" = ">= 0.4.2-dev",
    "blackstork/github" = ">= 0.4.2-dev"
  }
}

config publish github_gist {
  github_token = env.GITHUB_TOKEN
}


config content llm_text gemini_pentest {
  vendor = "google"
  model = "googleai/gemini-3-flash-preview"

  api_key = env.GEMINI_KEY

  system_prompt = "You're an experienced penetration tester excelling in writing clear, detailed and easy-to-understand penetration assessment reports"
}

